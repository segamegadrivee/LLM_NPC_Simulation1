  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneContextObject
  objectId: church
  displayName: Old Church
  objectType: Building
  description: An old stone church that stands near the village square. It was built
    before most of the current houses and is treated by villagers as a place of memory,
    gathering, and protection. Its bell used to call people together during danger,
    funerals, village meetings, and important announcements. Now the bell is missing,
    and the silence of the church makes the village feel unsafe and uneasy.
  tags:
  - church
  - bell
  - history
  - tradition
  - memory
  - village
  - symbol
  stateFacts:
  - bellMissing = true
  - caretaker = Anselm
  - villageMoodAroundChurch = worried
  - bellWasUsedForWarnings = true
  - villagersRespectChurch = true
