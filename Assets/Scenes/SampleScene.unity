MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 739604013}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7dde1faf6ac8848188b51dc197e8f2fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneContextObject
  objectId: church
  displayName: The Old Church
  objectType: Building
  description: The old stone church beside the village square, the first building
    the founding families raised when they settled here generations ago. Ever since,
    it has been where the village gathers for weddings, namings, funerals, and the
    seasonal festivals, and where its shared memory is kept. Anselm has cared for the
    church and its traditions for many years. Its bell once marked the hours and called
    people together or warned of danger, but the bell is only one part of what the
    place means; even silent now, the church remains the steady heart of the village.
  tags:
  - church
  - history
  - founders
  - settlers
  - tradition
  - ceremonies
  - gathering
  - memory
  - bell
  - sacred
  stateFacts:
  - Anselm is the caretaker of the church
  - The oldest building, raised by the founding families
  - Weddings, namings, funerals, and seasonal festivals are held here
  - It holds the village's shared memory and traditions
  - The bell marked the hours and warned of danger
  - bellMissing = true
  - villageMoodAroundChurch = worried
